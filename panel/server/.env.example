PORT=3001
DB_FILE_NAME=./src/database/cubaware.sqlite
NEXT_PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=<generate: openssl rand -hex 32>
CUBACLIENT_API_KEY=<set in builder UI, or generate: openssl rand -hex 20>
CUBACLIENT_ZIP_PASS=<set in builder UI>

# Absolute path to the C++ client source root
CLIENT_DIR=/absolute/path/to/CubaWare/client/CubaClient/CubaClient

# TLS — required for release builds (client always uses HTTPS)
# Generate cert: see setup.md
# TLS_CERT=/absolute/path/to/panel/server/ssl/cert.pem
# TLS_KEY=/absolute/path/to/panel/server/ssl/key.pem
